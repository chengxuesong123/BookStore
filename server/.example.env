APP_DEBUG = true
APP_TRACE = false

DEFAULT_LANG = zh-cn
DEFAULT_TIMEZONE = Asia/Shanghai

DB_TYPE = mysql
DB_HOST = 127.0.0.1
DB_NAME = bookstore
DB_USER = root
DB_PASS = 123456
DB_PORT = 3306
DB_CHARSET = utf8mb4

# 封面 API（Open Library / Google Books）
# 国内直连通常超时，可填本机代理，例如 Clash 默认 127.0.0.1:7897
COVER_PROXY =
# 可选：Google Books API Key，不填容易被 429 限流
COVER_GOOGLE_KEY =
